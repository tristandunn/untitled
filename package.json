{
  "name": "untitled",
  "private": true,
  "type": "module",
  "scripts": {
    "check:erb": "herb-format --check .",
    "fix:css": "prettier --write app/assets/tailwind/**/*.css",
    "fix:erb": "herb-format .",
    "fix:js": "eslint --fix .",
    "lint:css": "stylelint app/assets/tailwind/**/*.css",
    "lint:js": "eslint .",
    "lint:erb": "herb-lint --format detailed --no-timing",
    "outdated": "yarn upgrade-interactive",
    "test": "bin/mocha spec/javascripts",
    "test:coverage": "c8 --100 --clean --report-dir tmp/ --reporter text-summary --skip-full bin/mocha spec/javascripts"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@herb-tools/formatter": "0.11.2",
    "@herb-tools/linter": "0.11.2",
    "@hotwired/stimulus": "3.2.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sinon": "22.1.0",
    "sinon-chai": "4.0.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
